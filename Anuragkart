<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amarkart - Shop India’s Best</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f7f8fc;
            --surface: #ffffff;
            --surface-soft: #eef2ff;
            --text: #1f2937;
            --text-muted: #6b7280;
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --accent: #f97316;
            --success: #16a34a;
            --border: #e5e7eb;
            --shadow: 0 14px 40px rgba(79, 70, 229, 0.12);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: radial-gradient(circle at 10% -20%, #e0e7ff 0%, var(--bg) 45%);
            color: var(--text);
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .container {
            width: min(1150px, calc(100% - 2rem));
            margin: 0 auto;
        }

        .navbar {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(229, 231, 235, 0.85);
        }

        .navbar-inner {
            display: flex;
            gap: 1rem;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 0;
        }

        .logo {
            font-size: 1.45rem;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: -0.03em;
        }

        .search-bar {
            flex: 1;
            max-width: 520px;
            position: relative;
        }

        .search-bar input {
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 0.8rem 7rem 0.8rem 1rem;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.25s, box-shadow 0.25s;
        }

        .search-bar input:focus {
            border-color: #c7d2fe;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15);
        }

        .search-bar button {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            background: var(--primary);
            color: #fff;
            border-radius: 10px;
            padding: 0.55rem 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s ease, background 0.2s ease;
        }

        .search-bar button:hover {
            background: var(--primary-dark);
            transform: translateY(-50%) scale(1.03);
        }

        .nav-links {
            display: flex;
            align-items: center;
            list-style: none;
            gap: 0.35rem;
        }

        .nav-links button {
            border: none;
            background: transparent;
            color: var(--text);
            font-weight: 600;
            padding: 0.6rem 0.85rem;
            border-radius: 10px;
            cursor: pointer;
            transition: background 0.2s, color 0.2s;
        }

        .nav-links button:hover,
        .nav-links button.active {
            background: var(--surface-soft);
            color: var(--primary);
        }

        main {
            padding: 2rem 0 2.5rem;
        }

        .section {
            display: none;
            animation: sectionEnter 420ms ease;
        }

        .section.active {
            display: block;
        }

        .hero {
            background: linear-gradient(135deg, #4338ca 0%, #7c3aed 55%, #f97316 100%);
            color: #fff;
            border-radius: 26px;
            padding: 4rem 2rem;
            text-align: center;
            box-shadow: var(--shadow);
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .hero::after {
            content: '';
            position: absolute;
            inset: -20% auto auto -20%;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
        }

        .hero h1 {
            font-size: clamp(2rem, 4vw, 3rem);
            line-height: 1.15;
            margin-bottom: 0.75rem;
        }

        .hero p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 1.05rem;
            margin-bottom: 1.5rem;
        }

        .cta-btn,
        .add-to-cart {
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 0.75rem 1.15rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-block;
            text-decoration: none;
            transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
        }

        .cta-btn:hover,
        .add-to-cart:hover {
            background: #ea580c;
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(234, 88, 12, 0.28);
        }

        h2, h1 {
            margin-bottom: 1rem;
            letter-spacing: -0.01em;
        }

        .filters {
            display: flex;
            flex-wrap: wrap;
            gap: 0.8rem;
            margin-bottom: 1.2rem;
        }

        .filters select,
        .filters input,
        .checkout-form input,
        .checkout-form select {
            border: 1px solid var(--border);
            background: var(--surface);
            border-radius: 12px;
            padding: 0.68rem 0.85rem;
            min-width: 130px;
            font: inherit;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.15rem;
        }

        .product,
        .cart-items,
        .checkout-form,
        .product-details {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
        }

        .product {
            padding: 1rem;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .product:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 35px rgba(79, 70, 229, 0.16);
        }

        .product img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 0.8rem;
        }

        .product h3 { font-size: 1rem; margin-bottom: 0.3rem; }
        .product .price, #product-price { color: var(--success); font-weight: 700; }
        .rating { color: #f59e0b; font-size: 0.82rem; margin: 0.35rem 0 0.7rem; }

        .product-details {
            display: grid;
            grid-template-columns: minmax(260px, 380px) 1fr;
            gap: 1.5rem;
            padding: 1.3rem;
        }

        .product-details img {
            width: 100%;
            border-radius: 14px;
            object-fit: cover;
            max-height: 360px;
        }

        .cart-items,
        .checkout-form {
            padding: 1.15rem;
        }

        .cart-items ul {
            list-style: none;
            margin-bottom: 0.8rem;
        }

        .cart-items li {
            display: flex;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.6rem 0;
            border-bottom: 1px solid var(--border);
        }

        .checkout-form form {
            display: grid;
            gap: 0.8rem;
            max-width: 520px;
        }

        footer {
            text-align: center;
            color: var(--text-muted);
            padding: 1.8rem 0 2.4rem;
        }

        @keyframes sectionEnter {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (max-width: 900px) {
            .navbar-inner { flex-wrap: wrap; }
            .search-bar { order: 3; max-width: 100%; }
            .product-details { grid-template-columns: 1fr; }
            .hero { padding: 3.2rem 1.25rem; }
        }
    </style>
</head>
<body>
<header class="navbar">
    <div class="container navbar-inner">
        <div class="logo">Amarkart</div>
        <div class="search-bar">
            <input type="text" placeholder="Search for products..." id="search-input">
            <button onclick="searchProducts()">Search</button>
        </div>
        <ul class="nav-links">
            <li><button data-target="home" class="active" onclick="showSection('home', this)">Home</button></li>
            <li><button data-target="shop" onclick="showSection('shop', this)">Shop</button></li>
            <li><button data-target="cart" onclick="showSection('cart', this)">Cart</button></li>
            <li><button data-target="checkout" onclick="showSection('checkout', this)">Checkout</button></li>
        </ul>
    </div>
</header>

<main class="container">
    <section id="home" class="section active">
        <div class="hero">
            <h1>Explore India’s Best Deals</h1>
            <p>Clothing, Electronics, Handcrafts, and more in one beautiful shopping experience.</p>
            <button class="cta-btn" onclick="showSection('shop')">Shop Now</button>
        </div>
        <h2>Bestsellers</h2>
        <div class="product-grid" id="bestsellers"></div>
    </section>

    <section id="shop" class="section">
        <h1>Shop All Products</h1>
        <div class="filters">
            <select id="sort" onchange="sortProducts()">
                <option value="default">Sort by</option>
                <option value="high-to-low">Price: High to Low</option>
                <option value="low-to-high">Price: Low to High</option>
            </select>
            <input type="number" placeholder="Min Price" id="min-price" oninput="filterProducts()">
            <input type="number" placeholder="Max Price" id="max-price" oninput="filterProducts()">
        </div>
        <div class="product-grid" id="shop-products"></div>
    </section>

    <section id="product" class="section">
        <div class="product-details">
            <img id="product-img" src="" alt="Product Image">
            <div class="info">
                <h1 id="product-name"></h1>
                <p class="price" id="product-price"></p>
                <div class="rating">★★★★☆ (4.5)</div>
                <p id="product-desc"></p>
                <div style="margin: 1rem 0;"><button class="add-to-cart" id="product-add-btn">Add to Cart</button></div>
                <p>Payment Options: <strong>UPI</strong> | <strong>COD</strong></p>
            </div>
        </div>
    </section>

    <section id="cart" class="section">
        <h1>Your Cart</h1>
        <div class="cart-items">
            <ul id="cart-items"></ul>
            <p>Total: ₹<span id="cart-total">0</span></p>
            <div style="margin-top: 0.9rem;"><button class="cta-btn" onclick="showSection('checkout')">Proceed to Checkout</button></div>
        </div>
    </section>

    <section id="checkout" class="section">
        <h1>Checkout</h1>
        <div class="checkout-form">
            <form onsubmit="placeOrder(event)">
                <input required type="text" placeholder="Full Name">
                <input required type="text" placeholder="Address">
                <input required type="text" placeholder="Pincode">
                <select required>
                    <option value="">Choose Payment Method</option>
                    <option>UPI</option>
                    <option>Cash on Delivery</option>
                </select>
                <button class="cta-btn" type="submit">Place Order</button>
            </form>
        </div>
    </section>
</main>

<footer>
    © 2026 Amarkart. Designed for a modern shopping experience.
</footer>

<script>
    const products = [
        { id: 1, name: 'Cotton Kurta', price: 899, desc: 'Comfortable cotton kurta for everyday wear.', img: 'https://images.unsplash.com/photo-1596755094514-f87e34085b2c?auto=format&fit=crop&w=600&q=80' },
        { id: 2, name: 'Bluetooth Earbuds', price: 1999, desc: 'Crystal-clear audio and all-day battery life.', img: 'https://images.unsplash.com/photo-1606220588913-b3aacb4d2f37?auto=format&fit=crop&w=600&q=80' },
        { id: 3, name: 'Handmade Vase', price: 1299, desc: 'Elegant handcrafted decor for your living room.', img: 'https://images.unsplash.com/photo-1612198790706-79f0f3f52f31?auto=format&fit=crop&w=600&q=80' },
        { id: 4, name: 'Running Shoes', price: 2499, desc: 'Lightweight shoes built for daily performance.', img: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80' }
    ];

    let filtered = [...products];
    let cart = [];

    function showSection(id, el) {
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        document.getElementById(id).classList.add('active');
        document.querySelectorAll('.nav-links button').forEach(b => b.classList.remove('active'));
        const navBtn = el || document.querySelector(`.nav-links button[data-target='${id}']`);
        if (navBtn) navBtn.classList.add('active');
    }

    function renderProducts(list, targetId) {
        const target = document.getElementById(targetId);
        target.innerHTML = list.map(p => `
            <article class="product">
                <img src="${p.img}" alt="${p.name}">
                <h3>${p.name}</h3>
                <div class="price">₹${p.price}</div>
                <div class="rating">★★★★☆ (4.5)</div>
                <button class="add-to-cart" onclick="viewProduct(${p.id})">View Product</button>
            </article>
        `).join('');
    }

    function viewProduct(id) {
        const p = products.find(item => item.id === id);
        if (!p) return;
        document.getElementById('product-img').src = p.img;
        document.getElementById('product-name').textContent = p.name;
        document.getElementById('product-price').textContent = `₹${p.price}`;
        document.getElementById('product-desc').textContent = p.desc;
        document.getElementById('product-add-btn').onclick = () => addToCart(id);
        showSection('product');
    }

    function addToCart(id) {
        const p = products.find(item => item.id === id);
        if (!p) return;
        cart.push(p);
        renderCart();
        showSection('cart');
    }

    function renderCart() {
        const list = document.getElementById('cart-items');
        list.innerHTML = cart.map(item => `<li><span>${item.name}</span><strong>₹${item.price}</strong></li>`).join('') || '<li>Your cart is empty</li>';
        const total = cart.reduce((sum, item) => sum + item.price, 0);
        document.getElementById('cart-total').textContent = total;
    }

    function searchProducts() {
        const query = document.getElementById('search-input').value.toLowerCase().trim();
        filtered = products.filter(p => p.name.toLowerCase().includes(query));
        renderProducts(filtered, 'shop-products');
        showSection('shop');
    }

    function sortProducts() {
        const mode = document.getElementById('sort').value;
        filtered.sort((a, b) => mode === 'low-to-high' ? a.price - b.price : mode === 'high-to-low' ? b.price - a.price : a.id - b.id);
        renderProducts(filtered, 'shop-products');
    }

    function filterProducts() {
        const min = Number(document.getElementById('min-price').value) || 0;
        const max = Number(document.getElementById('max-price').value) || Infinity;
        filtered = products.filter(p => p.price >= min && p.price <= max);
        sortProducts();
    }

    function placeOrder(e) {
        e.preventDefault();
        if (!cart.length) {
            alert('Your cart is empty. Add products before checkout.');
            return;
        }
        alert('Order placed successfully! Thank you for shopping with Amarkart.');
        cart = [];
        renderCart();
        showSection('home');
    }

    renderProducts(products.slice(0, 3), 'bestsellers');
    renderProducts(products, 'shop-products');
    renderCart();
</script>
</body>
</html>
