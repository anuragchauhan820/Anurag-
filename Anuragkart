<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LifePilot AI | Decision Helper</title>
  <style>
    :root {
      --bg: #0b1120;
      --surface: rgba(15, 23, 42, 0.75);
      --surface-light: #f8fafc;
      --text: #e2e8f0;
      --text-dark: #0f172a;
      --muted: #94a3b8;
      --primary: #38bdf8;
      --accent: #a78bfa;
      --border: rgba(148, 163, 184, 0.25);
      --shadow: 0 10px 30px rgba(2, 6, 23, 0.35);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, "Segoe UI", Roboto, Arial, sans-serif;
    }

    body {
      background: radial-gradient(circle at 20% 20%, #1e293b, #0b1120 45%), var(--bg);
      color: var(--text);
      line-height: 1.65;
      min-height: 100vh;
    }

    .container {
      width: min(1100px, 92%);
      margin: 0 auto;
    }

    header {
      position: sticky;
      top: 0;
      backdrop-filter: blur(12px);
      background: rgba(11, 17, 32, 0.75);
      border-bottom: 1px solid var(--border);
      z-index: 99;
    }

    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.9rem 0;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .brand {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: 0.4px;
      color: #f8fafc;
    }

    .brand span {
      color: var(--primary);
    }

    .nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      list-style: none;
      font-size: 0.95rem;
      color: var(--muted);
    }

    .nav-links a {
      color: inherit;
      text-decoration: none;
    }

    .hero {
      padding: 5rem 0 3rem;
      text-align: center;
    }

    .pill {
      display: inline-block;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.4rem 0.8rem;
      color: var(--primary);
      margin-bottom: 1rem;
      font-size: 0.88rem;
      background: rgba(56, 189, 248, 0.08);
    }

    h1 {
      font-size: clamp(1.85rem, 5vw, 3.2rem);
      line-height: 1.2;
      margin-bottom: 1rem;
    }

    .hero p {
      max-width: 680px;
      margin: 0 auto 1.8rem;
      color: var(--muted);
      font-size: 1.05rem;
    }

    .btn {
      display: inline-block;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      border: none;
      border-radius: 10px;
      padding: 0.85rem 1.25rem;
      font-weight: 700;
      color: #020617;
      text-decoration: none;
      cursor: pointer;
      transition: transform 0.2s ease;
      box-shadow: var(--shadow);
    }

    .btn:hover { transform: translateY(-2px); }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
    }

    section { margin-bottom: 2.2rem; }

    .ask {
      padding: 1.2rem;
    }

    .ask h2,
    .section-title {
      font-size: 1.5rem;
      margin-bottom: 0.7rem;
      color: #f8fafc;
    }

    .ask p { color: var(--muted); margin-bottom: 1rem; }

    .ask-form {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
    }

    textarea {
      width: 100%;
      min-height: 110px;
      resize: vertical;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: rgba(15, 23, 42, 0.7);
      color: var(--text);
      padding: 0.9rem;
      font-size: 0.98rem;
    }

    #advice {
      margin-top: 0.95rem;
      padding: 0.95rem;
      border-radius: 12px;
      border: 1px solid rgba(56, 189, 248, 0.35);
      background: rgba(56, 189, 248, 0.08);
      color: #e0f2fe;
      min-height: 52px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    .feature {
      padding: 1rem;
    }

    .icon {
      font-size: 1.5rem;
      margin-bottom: 0.65rem;
      display: inline-block;
    }

    .feature h3 { font-size: 1.03rem; margin-bottom: 0.35rem; }
    .feature p { color: var(--muted); font-size: 0.95rem; }

    .dual {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .list-card {
      padding: 1.1rem;
      background: linear-gradient(145deg, rgba(30, 41, 59, 0.85), rgba(15, 23, 42, 0.75));
    }

    .list-card ul {
      margin-left: 1.1rem;
      color: var(--muted);
    }

    .list-card li { margin-bottom: 0.5rem; }

    footer {
      text-align: center;
      color: var(--muted);
      padding: 1.4rem 0 2rem;
      font-size: 0.92rem;
    }

    @media (max-width: 900px) {
      .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .dual { grid-template-columns: 1fr; }
      .ask-form { grid-template-columns: 1fr; }
    }

    @media (max-width: 540px) {
      .hero { padding-top: 3.8rem; }
      .grid { grid-template-columns: 1fr; }
      .nav { justify-content: center; }
      .nav-links { justify-content: center; }
    }

    .light-panel {
      background: var(--surface-light);
      color: var(--text-dark);
      border-radius: 16px;
      border: 1px solid #cbd5e1;
      padding: 1rem;
    }

    .light-panel p { color: #334155; }
  </style>
</head>
<body>
  <header>
    <div class="container nav">
      <div class="brand">Life<span>Pilot AI</span></div>
      <ul class="nav-links">
        <li><a href="#features">Features</a></li>
        <li><a href="#how">How It Works</a></li>
        <li><a href="#benefits">Benefits</a></li>
      </ul>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <span class="pill">AI Life Decision Helper</span>
      <h1>Ask AI Anything About Your Life Decisions</h1>
      <p>Get practical, personalized guidance for your studies, career plans, fitness goals, and daily productivity—designed for students and young people.</p>
      <a class="btn" href="#ask">Ask AI Now</a>
    </section>

    <section id="ask" class="card ask">
      <h2>Get AI Advice Instantly</h2>
      <p>Type your question and receive clear next steps you can apply right away.</p>
      <div class="ask-form">
        <textarea id="question" placeholder="Example: Should I focus on coding internships or higher studies this year?"></textarea>
        <button class="btn" onclick="getAdvice()">Ask AI Now</button>
      </div>
      <div id="advice">Your AI guidance will appear here.</div>
    </section>

    <section id="features">
      <h2 class="section-title">Features</h2>
      <div class="grid">
        <article class="card feature"><span class="icon">📚</span><h3>Study Planner</h3><p>Plan smarter exam prep and choose the right learning path.</p></article>
        <article class="card feature"><span class="icon">💼</span><h3>Career Direction</h3><p>Compare career options and make confident decisions.</p></article>
        <article class="card feature"><span class="icon">🏃</span><h3>Health & Fitness</h3><p>Build habits that balance physical wellness with busy schedules.</p></article>
        <article class="card feature"><span class="icon">⚡</span><h3>Daily Productivity</h3><p>Get quick routines to reduce stress and improve focus each day.</p></article>
      </div>
    </section>

    <section id="how" class="dual">
      <article class="card list-card">
        <h2 class="section-title">How It Works</h2>
        <ul>
          <li>Share your question in natural language.</li>
          <li>AI analyzes your priorities and constraints.</li>
          <li>Receive simple, actionable advice with next steps.</li>
        </ul>
      </article>
      <article class="light-panel">
        <h2 class="section-title">Benefits</h2>
        <p>Make faster and better life decisions with personalized support that feels clear, modern, and easy to follow.</p>
        <ul>
          <li>Reduces confusion and overthinking</li>
          <li>Supports better long-term planning</li>
          <li>Helps you stay consistent and motivated</li>
        </ul>
      </article>
    </section>
  </main>

  <footer>
    Built for young achievers • LifePilot AI Decision Helper
  </footer>

  <script>
    const suggestions = [
      "Start with a 30-day experiment: set one main goal, review progress weekly, and adapt your plan based on what works.",
      "Use a 70/20/10 approach: spend 70% effort on your priority, 20% on skill building, and 10% on exploration.",
      "Choose the option that gives both short-term momentum and long-term growth, then define 3 measurable actions for this week.",
      "Break your decision into factors: time, cost, energy, and opportunity. Score each option from 1 to 10 and pick the highest total."
    ];

    function getAdvice() {
      const input = document.getElementById("question");
      const output = document.getElementById("advice");
      const question = input.value.trim();

      if (!question) {
        output.textContent = "Please enter a question so AI can help you with a clear suggestion.";
        return;
      }

      const pick = suggestions[Math.floor(Math.random() * suggestions.length)];
      output.textContent = `Question received: "${question}". Suggested next step: ${pick}`;
    }
  </script>
</body>
</html>
